<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <Company>HMD Software</Company>
    <Authors>LouiDev</Authors>
    <Product>Bastion</Product>
    <Copyright>Copyright (c) 2026 LouiDev</Copyright>
    <Version>1.0.0</Version>
    <NeutralLanguage>en</NeutralLanguage>
    <PackageLicenseExpression>PolyForm-Noncommercial-1.0.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/LouiDev/Bastion</RepositoryUrl>
    <PackageProjectUrl>https://github.com/LouiDev/Bastion</PackageProjectUrl>
  </PropertyGroup>
</Project>
