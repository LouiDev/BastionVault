<UserControl x:Class="BastionVault.App.Shell.TitleBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BastionVault.App.Controls"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:vm="clr-namespace:BastionVault.App.ViewModels"
             Height="{DynamicResource Height.TitleBar}"
             Background="{DynamicResource Brush.Bg0}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Logo: the lamp, and the only place the app name appears when no vault is open. -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource Style.Glyph16}"
                       Text="{DynamicResource Glyph.NewVault}"
                       Foreground="{DynamicResource Brush.Accent}" />
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                       Style="{StaticResource Text.Caption}"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Text="BASTION VAULT" />
        </StackPanel>

        <!-- Chamfered vault chip: the only chamfered shape in the app. -->
        <controls:ChamferedBorder Grid.Column="1"
                                  x:Name="VaultChip"
                                  Margin="12,0,0,0"
                                  Padding="10,0"
                                  Height="24"
                                  VerticalAlignment="Center"
                                  ChamferSize="8"
                                  Background="{DynamicResource Brush.Bg2}"
                                  BorderBrush="{DynamicResource Brush.AccentDim}"
                                  BorderThickness="1"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                  Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="LockGlyph"
                           Style="{StaticResource Style.Glyph}"
                           FontSize="12"
                           Text="{DynamicResource Glyph.Unlocked}"
                           Foreground="{DynamicResource Brush.Accent}" />
                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource Text.Caption}"
                           Foreground="{DynamicResource Brush.TextPrimary}"
                           Text="{Binding VaultName}" />
                <Button x:Name="DirtyBullet"
                        Margin="4,0,0,0"
                        Style="{StaticResource Button.Ghost}"
                        Height="20" MinWidth="18" Padding="2,0"
                        ToolTip="Unsaved changes"
                        Visibility="Collapsed"
                        Click="OnShowPending">
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Foreground="{DynamicResource Brush.Accent}"
                               FontSize="14"
                               Text="&#x2022;" />
                </Button>

                <Popup x:Name="PendingPopup"
                       PlacementTarget="{Binding ElementName=VaultChip}"
                       Placement="Bottom"
                       VerticalOffset="6"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <ContentControl Content="{Binding PendingChanges}" />
                </Popup>
            </StackPanel>
        </controls:ChamferedBorder>

        <!-- Drag region. -->
        <TextBlock Grid.Column="2" />

        <!-- Caption buttons. -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
            <Button x:Name="MinimizeButtonElement"
                    Style="{StaticResource Button.Caption}"
                    Content="{DynamicResource Glyph.Minimize}"
                    AutomationProperties.Name="Minimize"
                    Click="OnMinimize" />
            <Button x:Name="MaximizeButtonElement"
                    Style="{StaticResource Button.Caption}"
                    Content="{DynamicResource Glyph.Maximize}"
                    AutomationProperties.Name="Maximize"
                    Click="OnMaximize" />
            <Button x:Name="CloseButtonElement"
                    Style="{StaticResource Button.CaptionClose}"
                    Content="{DynamicResource Glyph.Close}"
                    AutomationProperties.Name="Close"
                    Click="OnClose" />
        </StackPanel>
    </Grid>
</UserControl>
