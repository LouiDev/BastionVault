<UserControl x:Class="BastionVault.App.Shell.UnlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BastionVault.App.Controls"
             xmlns:vm="clr-namespace:BastionVault.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:UnlockViewModel}"
             Background="{DynamicResource Brush.Bg0}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid>
        <Viewbox Width="260" Height="260" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,56,56" IsHitTestVisible="False">
            <Path Style="{StaticResource Style.Blueprint}" Data="{StaticResource Blueprint.Padlock}" />
        </Viewbox>

        <Border Width="440"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource Brush.Bg1}"
                BorderBrush="{DynamicResource Brush.StrokeDivider}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Radius.Dialog}"
                Padding="20">
            <StackPanel>

                <!-- The chamfered chip repeats here: same shape, same meaning. -->
                <controls:ChamferedBorder HorizontalAlignment="Left"
                                          Padding="10,4"
                                          ChamferSize="8"
                                          Background="{DynamicResource Brush.Bg2}"
                                          BorderBrush="{DynamicResource Brush.StrokeControl}"
                                          BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Style.Glyph}" FontSize="12"
                                   Text="{DynamicResource Glyph.Lock}" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                   Style="{StaticResource Text.BodyStrong}"
                                   Text="{Binding VaultName}" />
                    </StackPanel>
                </controls:ChamferedBorder>

                <TextBlock Margin="0,10,0,0"
                           Style="{StaticResource Text.Mono}"
                           TextWrapping="Wrap"
                           Text="{Binding HeaderLine}" />

                <TextBlock Margin="0,2,0,0"
                           Style="{StaticResource Text.Caption}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding VaultPath}"
                           Text="{Binding VaultPath}" />

                <Separator Style="{StaticResource Style.Seam}" Margin="0,16,0,16" />

                <TextBlock Style="{StaticResource Text.Caption}" Text="Password" />
                <PasswordBox x:Name="PasswordField"
                             Margin="0,4,0,0"
                             PasswordChanged="OnPasswordChanged"
                             KeyDown="OnPasswordKeyDown"
                             AutomationProperties.Name="Vault password" />

                <!-- Caps Lock banner -->
                <Border x:Name="CapsBanner"
                        Margin="0,8,0,0" Padding="10,6"
                        Visibility="Collapsed"
                        Background="{DynamicResource Brush.Bg2}"
                        BorderBrush="{DynamicResource Brush.Warning}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Small}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Style.Glyph}" FontSize="12"
                                   Text="{DynamicResource Glyph.Warning}"
                                   Foreground="{DynamicResource Brush.Warning}" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                   Style="{StaticResource Text.Caption}"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   Text="Caps Lock is on." />
                    </StackPanel>
                </Border>

                <!-- Keyfile -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.Caption}" Text="Keyfile (optional)" />
                        <TextBlock Style="{StaticResource Text.Body}"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Text="{Binding KeyFilePath, TargetNullValue='none'}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Button.Link}" Content="Choose..."
                                Command="{Binding ChooseKeyFileCommand}" />
                        <Button Style="{StaticResource Button.Link}" Content="Remove"
                                Command="{Binding RemoveKeyFileCommand}"
                                Visibility="{Binding HasKeyFile, Converter={StaticResource Converter.BoolToVisibility}}" />
                    </StackPanel>
                </Grid>

                <!-- Errors: one of the three classes of FORMAT.md section 9. -->
                <Border Margin="0,12,0,0" Padding="10,8"
                        Background="{DynamicResource Brush.Bg2}"
                        BorderBrush="{DynamicResource Brush.DangerText}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Small}"
                        Visibility="{Binding HasError, Converter={StaticResource Converter.BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Text.Body}"
                               Foreground="{DynamicResource Brush.DangerText}"
                               TextWrapping="Wrap"
                               Text="{Binding Error}" />
                </Border>

                <!-- Rollback warning -->
                <Border Margin="0,12,0,0" Padding="10,8"
                        Background="{DynamicResource Brush.Bg2}"
                        BorderBrush="{DynamicResource Brush.Warning}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Small}"
                        Visibility="{Binding HasRollbackWarning, Converter={StaticResource Converter.BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Text.Body}"
                               Foreground="{DynamicResource Brush.Warning}"
                               TextWrapping="Wrap"
                               Text="{Binding RollbackWarning}" />
                </Border>

                <Button x:Name="UnlockButton"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource Button.Primary}"
                        IsEnabled="{Binding CanSubmit}"
                        Click="OnUnlock">
                    <TextBlock x:Name="UnlockLabel" Text="Unlock" />
                </Button>

                <TextBlock Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           Style="{StaticResource Text.Mono}"
                           Visibility="{Binding StatusLine, Converter={StaticResource Converter.NotEmptyToVisibility}}"
                           Text="{Binding StatusLine}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
