<!--
    Lamplight design tokens (UI-CONTRACT.md §2).
    Every colour of the palette exists twice: as Color.<Name> and as Brush.<Name>.
    Consumers always use DynamicResource so Themes/HighContrast.xaml can be swapped in.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ══ Grounds ══ -->
    <Color x:Key="Color.Bg0">#FF0E1116</Color>
    <Color x:Key="Color.Bg1">#FF151922</Color>
    <Color x:Key="Color.Bg2">#FF1C222D</Color>
    <Color x:Key="Color.Bg3">#FF232B38</Color>

    <!-- ══ Strokes ══ -->
    <Color x:Key="Color.StrokeDivider">#FF2A3241</Color>
    <Color x:Key="Color.StrokeShadow">#FF0B0E13</Color>
    <Color x:Key="Color.StrokeControl">#FF626E86</Color>
    <Color x:Key="Color.StrokeControlHover">#FF7B879F</Color>

    <!-- ══ Text ══ -->
    <Color x:Key="Color.TextPrimary">#FFE7EAF0</Color>
    <Color x:Key="Color.TextSecondary">#FF9AA3B2</Color>
    <Color x:Key="Color.TextDisabled">#FF767F90</Color>
    <Color x:Key="Color.TextMono">#FFC9D1DE</Color>

    <!-- ══ The lamp ══ -->
    <Color x:Key="Color.Accent">#FFF2A93B</Color>
    <Color x:Key="Color.AccentHover">#FFFFBE5C</Color>
    <Color x:Key="Color.AccentPressed">#FFD9922B</Color>
    <Color x:Key="Color.AccentDim">#FF8A6222</Color>
    <Color x:Key="Color.OnAccent">#FF1A1408</Color>

    <!-- ══ Focus ══ -->
    <Color x:Key="Color.FocusOuter">#FFFFD48A</Color>
    <Color x:Key="Color.FocusInner">#FF0E1116</Color>

    <!-- ══ Selection ══ -->
    <Color x:Key="Color.SelectRest">#FF2B2724</Color>
    <Color x:Key="Color.SelectInactive">#FF232833</Color>

    <!-- ══ Status ══ -->
    <Color x:Key="Color.DangerText">#FFFF6B6F</Color>
    <Color x:Key="Color.DangerFill">#FFB32830</Color>
    <Color x:Key="Color.Success">#FF3DD68C</Color>
    <Color x:Key="Color.Warning">#FFF5C542</Color>
    <Color x:Key="Color.Info">#FF4CA6FF</Color>
    <Color x:Key="Color.Scrim">#A60A0C10</Color>

    <!-- ══ Brushes ══ -->
    <SolidColorBrush x:Key="Brush.Bg0" Color="{StaticResource Color.Bg0}" />
    <SolidColorBrush x:Key="Brush.Bg1" Color="{StaticResource Color.Bg1}" />
    <SolidColorBrush x:Key="Brush.Bg2" Color="{StaticResource Color.Bg2}" />
    <SolidColorBrush x:Key="Brush.Bg3" Color="{StaticResource Color.Bg3}" />
    <SolidColorBrush x:Key="Brush.StrokeDivider" Color="{StaticResource Color.StrokeDivider}" />
    <SolidColorBrush x:Key="Brush.StrokeShadow" Color="{StaticResource Color.StrokeShadow}" />
    <SolidColorBrush x:Key="Brush.StrokeControl" Color="{StaticResource Color.StrokeControl}" />
    <SolidColorBrush x:Key="Brush.StrokeControlHover" Color="{StaticResource Color.StrokeControlHover}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="{StaticResource Color.TextDisabled}" />
    <SolidColorBrush x:Key="Brush.TextMono" Color="{StaticResource Color.TextMono}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="{StaticResource Color.AccentPressed}" />
    <SolidColorBrush x:Key="Brush.AccentDim" Color="{StaticResource Color.AccentDim}" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}" />
    <SolidColorBrush x:Key="Brush.FocusOuter" Color="{StaticResource Color.FocusOuter}" />
    <SolidColorBrush x:Key="Brush.FocusInner" Color="{StaticResource Color.FocusInner}" />
    <SolidColorBrush x:Key="Brush.SelectRest" Color="{StaticResource Color.SelectRest}" />
    <SolidColorBrush x:Key="Brush.SelectInactive" Color="{StaticResource Color.SelectInactive}" />
    <SolidColorBrush x:Key="Brush.DangerText" Color="{StaticResource Color.DangerText}" />
    <SolidColorBrush x:Key="Brush.DangerFill" Color="{StaticResource Color.DangerFill}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}" />
    <SolidColorBrush x:Key="Brush.Scrim" Color="{StaticResource Color.Scrim}" />
    <SolidColorBrush x:Key="Brush.Transparent" Color="Transparent" />

    <!-- ══ Radii ══ -->
    <CornerRadius x:Key="Radius.Small">4</CornerRadius>
    <CornerRadius x:Key="Radius.Medium">6</CornerRadius>
    <CornerRadius x:Key="Radius.Dialog">8</CornerRadius>

    <!-- ══ Spacing ramp (2 / 4 / 8 / 12 / 16 / 24 / 32 / 48) ══ -->
    <Thickness x:Key="Space.Related">0,0,0,8</Thickness>
    <Thickness x:Key="Space.Group">0,0,0,16</Thickness>
    <Thickness x:Key="Pad.Window">12</Thickness>
    <Thickness x:Key="Pad.Card">20</Thickness>
    <Thickness x:Key="Pad.Dialog">24</Thickness>

    <!-- ══ Heights ══ -->
    <sys:Double x:Key="Height.TitleBar">40</sys:Double>
    <sys:Double x:Key="Height.CommandBar">44</sys:Double>
    <sys:Double x:Key="Height.Breadcrumb">32</sys:Double>
    <sys:Double x:Key="Height.Input">32</sys:Double>
    <sys:Double x:Key="Height.CommandButton">32</sys:Double>
    <sys:Double x:Key="Height.DialogButton">36</sys:Double>
    <sys:Double x:Key="Height.StatusBar">26</sys:Double>

    <!-- Row height is re-declared by the row-density setting; always DynamicResource it. -->
    <sys:Double x:Key="RowHeight">28</sys:Double>
    <sys:Double x:Key="RowHeight.Compact">24</sys:Double>
    <sys:Double x:Key="RowHeight.Comfortable">28</sys:Double>
    <sys:Double x:Key="RowHeight.Spacious">32</sys:Double>

    <!-- ══ Motion ══ -->
    <KeySpline x:Key="Ease.Out">0.2,0,0,1</KeySpline>
    <Duration x:Key="Duration.Hover">0:0:0.12</Duration>
    <Duration x:Key="Duration.Overlay">0:0:0.18</Duration>

</ResourceDictionary>
