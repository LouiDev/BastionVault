<!-- Slider: 4 px rail, 16 px thumb. Used for the auto-lock delay and preview quality. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="Slider.Thumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid>
                        <Ellipse x:Name="Disc"
                                 Fill="{DynamicResource Brush.Bg3}"
                                 Stroke="{DynamicResource Brush.StrokeControl}"
                                 StrokeThickness="1" />
                        <Ellipse x:Name="Core" Width="6" Height="6" Fill="{DynamicResource Brush.TextSecondary}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Disc" Property="Stroke" Value="{DynamicResource Brush.StrokeControlHover}" />
                            <Setter TargetName="Core" Property="Fill" Value="{DynamicResource Brush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Core" Property="Fill" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Disc" Property="Opacity" Value="0.5" />
                            <Setter TargetName="Core" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Slider.RailButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" Height="16" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Slider.Default" TargetType="Slider">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Background" Value="{DynamicResource Brush.Bg3}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDim}" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.Ring}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent" MinHeight="{TemplateBinding MinHeight}">
                        <Border Height="4" VerticalAlignment="Center" CornerRadius="2"
                                Background="{TemplateBinding Background}" />
                        <Border x:Name="Fill" Height="4" VerticalAlignment="Center" CornerRadius="2"
                                HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"
                                Width="{Binding ActualWidth, ElementName=PART_Decrease}" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="PART_Decrease" Style="{StaticResource Slider.RailButton}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Slider.Thumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Slider.RailButton}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fill" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider" BasedOn="{StaticResource Slider.Default}" />

</ResourceDictionary>
