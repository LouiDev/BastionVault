<!--
    Rule-and-caps section header (UI-CONTRACT.md section 2, signature detail 6).
    The two style references are DynamicResource on purpose: a StaticResource inside a
    ControlTemplate is resolved against this dictionary alone and cannot see the sibling
    dictionaries Lamplight merges next to it.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:BastionVault.App.Controls">

    <Style x:Key="SectionHeader.Default" TargetType="controls:SectionHeader">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SectionHeader">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Style="{DynamicResource Text.SectionLabel}"
                                   Text="{Binding DisplayText, RelativeSource={RelativeSource TemplatedParent}}"
                                   VerticalAlignment="Center" />
                        <Rectangle Grid.Column="1" Margin="10,0,0,0"
                                   Style="{DynamicResource Style.Hairline}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:SectionHeader" BasedOn="{StaticResource SectionHeader.Default}" />

</ResourceDictionary>
