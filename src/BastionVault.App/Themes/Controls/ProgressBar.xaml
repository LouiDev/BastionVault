<!--
    Progress bars. A 4 px rail: the determinate fill is the dimmed lamp (the same tone the
    state stripe uses for "unlocked and saved"); the indeterminate state is the amber
    shimmer of the state stripe, so "something is running" always looks the same.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="ProgressBar.Default" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Background" Value="{DynamicResource Brush.Bg3}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentDim}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="Root" ClipToBounds="True">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="2" SnapsToDevicePixels="True" />

                        <!-- Determinate fill -->
                        <Border x:Name="PART_Track" />
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True" />

                        <!-- Indeterminate shimmer -->
                        <Rectangle x:Name="Shimmer" Visibility="Collapsed" RadiusX="2" RadiusY="2">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop x:Name="S0" Color="#00F2A93B" Offset="-0.40" />
                                    <GradientStop x:Name="S1" Color="#FFF2A93B" Offset="-0.20" />
                                    <GradientStop x:Name="S2" Color="#00F2A93B" Offset="0.00" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Shimmer" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ShimmerStory">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="S0"
                                                         Storyboard.TargetProperty="Offset"
                                                         From="-0.40" To="1.00" Duration="0:0:1.4" />
                                        <DoubleAnimation Storyboard.TargetName="S1"
                                                         Storyboard.TargetProperty="Offset"
                                                         From="-0.20" To="1.20" Duration="0:0:1.4" />
                                        <DoubleAnimation Storyboard.TargetName="S2"
                                                         Storyboard.TargetProperty="Offset"
                                                         From="0.00" To="1.40" Duration="0:0:1.4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="ShimmerStory" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter Property="Width" Value="4" />
                            <Setter Property="Height" Value="Auto" />
                            <Setter TargetName="PART_Indicator" Property="HorizontalAlignment" Value="Stretch" />
                            <Setter TargetName="PART_Indicator" Property="VerticalAlignment" Value="Bottom" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ProgressBar" BasedOn="{StaticResource ProgressBar.Default}" />

    <!-- A taller rail for the progress dialog, where the bar is the main instrument. -->
    <Style x:Key="ProgressBar.Dialog" TargetType="ProgressBar" BasedOn="{StaticResource ProgressBar.Default}">
        <Setter Property="Height" Value="6" />
    </Style>

</ResourceDictionary>
