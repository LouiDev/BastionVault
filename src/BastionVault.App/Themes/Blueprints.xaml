<!--
    Blueprint line art for empty states (UI-CONTRACT.md section 2, signature detail 7): 1 px amber
    strokes at 20 % opacity, drawn as geometry so they stay crisp at every DPI. Each geometry is
    authored on a 160 x 160 grid; scale with a Viewbox.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Vault door: frame, two rings, hub, spokes, handle bar. -->
    <StreamGeometry x:Key="Blueprint.VaultDoor">
        M8,8 L152,8 L152,152 L8,152 Z
        M20,80 A60,60 0 1 1 140,80 A60,60 0 1 1 20,80 Z
        M36,80 A44,44 0 1 1 124,80 A44,44 0 1 1 36,80 Z
        M68,80 A12,12 0 1 1 92,80 A12,12 0 1 1 68,80 Z
        M80,68 L80,36 M80,92 L80,124 M68,80 L36,80 M92,80 L124,80
        M71,71 L49,49 M89,89 L111,111 M89,71 L111,49 M71,89 L49,111
        M124,80 L150,80 M150,72 L150,88
        M20,20 L28,28 M140,20 L132,28 M20,140 L28,132 M140,140 L132,132
    </StreamGeometry>

    <!-- Open folder. -->
    <StreamGeometry x:Key="Blueprint.Folder">
        M16,44 L68,44 L80,58 L144,58 L144,124 L16,124 Z
        M16,124 L36,76 L160,76 L140,124 Z
        M16,44 L16,124
    </StreamGeometry>

    <!-- Magnifier over a rule (no results). -->
    <StreamGeometry x:Key="Blueprint.Magnifier">
        M30,70 A40,40 0 1 1 110,70 A40,40 0 1 1 30,70 Z
        M100,100 L140,140
        M44,62 A26,26 0 0 1 62,44
        M20,150 L140,150
    </StreamGeometry>

    <!-- Padlock (locked state). -->
    <StreamGeometry x:Key="Blueprint.Padlock">
        M40,74 L120,74 L120,140 L40,140 Z
        M56,74 L56,50 A24,24 0 0 1 104,50 L104,74
        M80,96 A8,8 0 1 1 80,112 A8,8 0 1 1 80,96 Z
        M80,112 L80,124
    </StreamGeometry>

    <Style x:Key="Style.Blueprint" TargetType="Path">
        <Setter Property="Stroke" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Opacity" Value="0.14" />
        <Setter Property="Fill" Value="{x:Null}" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

</ResourceDictionary>
