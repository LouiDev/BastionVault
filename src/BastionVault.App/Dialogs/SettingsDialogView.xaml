<UserControl x:Class="BastionVault.App.Dialogs.SettingsDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BastionVault.App.Controls"
             xmlns:dialogs="clr-namespace:BastionVault.App.ViewModels.Dialogs"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=dialogs:SettingsDialogViewModel}">

    <UserControl.Resources>
        <!--
            Every drop-down here is bound to Choice<T> records. A display-member path alone is not
            enough: the closed selection box renders SelectionBoxItem through SelectionBoxItemTemplate,
            which stays null in that case, so the record's ToString showed up in the box. An explicit
            ItemTemplate fills both the list and the box (and the two settings are mutually exclusive).
        -->
        <DataTemplate x:Key="Settings.ChoiceItem">
            <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="24" MinWidth="560" MaxWidth="640">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Title}" Text="{Binding Title}" />

        <Grid DockPanel.Dock="Bottom" Margin="0,20,0,0">
            <TextBlock Style="{StaticResource Text.Caption}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="330"
                       HorizontalAlignment="Left"
                       Text="{Binding Status}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Button.Default}" Height="36" Margin="0,0,8,0"
                        Content="Cancel" Command="{Binding CancelCommand}" />
                <Button Style="{StaticResource Button.Primary}"
                        Content="Save settings" Command="{Binding SaveCommand}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">

                <controls:SectionHeader Text="Locking" />
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Text.Body}" VerticalAlignment="Center"
                               Text="Lock after idle (minutes)" />
                    <ComboBox Grid.Column="1" HorizontalAlignment="Left" Width="140"
                              ItemsSource="{Binding AutoLockChoices}"
                              ItemTemplate="{StaticResource Settings.ChoiceItem}" SelectedValuePath="Value"
                              SelectedValue="{Binding AutoLockMinutes}" />
                </Grid>

                <controls:SectionHeader Text="Appearance" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Text="Theme" />
                    <ComboBox Grid.Column="1" HorizontalAlignment="Left" Width="340"
                              ToolTip="High contrast follows the Windows setting."
                              ItemsSource="{Binding Themes}"
                              ItemTemplate="{StaticResource Settings.ChoiceItem}" SelectedValuePath="Value" SelectedValue="{Binding Theme}" />
                </Grid>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Text="Row density" />
                    <ComboBox Grid.Column="1" HorizontalAlignment="Left" Width="260"
                              ItemsSource="{Binding RowDensities}"
                              ItemTemplate="{StaticResource Settings.ChoiceItem}" SelectedValuePath="Value" SelectedValue="{Binding RowDensity}" />
                </Grid>

                <controls:SectionHeader Text="New vaults" />
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Text.Body}" VerticalAlignment="Center"
                               Text="Default key-derivation preset" />
                    <ComboBox Grid.Column="1" HorizontalAlignment="Left" Width="260"
                              ItemsSource="{Binding KdfPresets}"
                              ItemTemplate="{StaticResource Settings.ChoiceItem}" SelectedValuePath="Value" SelectedValue="{Binding DefaultKdfPreset}" />
                </Grid>

                <controls:SectionHeader Text="Privacy" />
                <CheckBox Margin="0,0,0,8" IsChecked="{Binding ExcludeFromScreenCapture}"
                          Content="Keep the window out of screen captures and Recall" />
                <CheckBox Margin="0,0,0,8" IsChecked="{Binding MaskNamesWhenInactive}"
                          Content="Mask entry names while the window is not active" />
                <CheckBox Margin="0,0,0,8" IsChecked="{Binding BlurPreviewWhenInactive}"
                          Content="Blur the preview while the window is not active" />
                <CheckBox Margin="0,0,0,16" IsChecked="{Binding PreviewEnabled}"
                          Content="Show the preview pane" />

                <controls:SectionHeader Text="Remembering" />
                <CheckBox Margin="0,0,0,8" IsChecked="{Binding RememberRecentVaults}"
                          Content="Remember which vaults were opened (stored under DPAPI)" />
                <CheckBox Margin="0,0,0,4" IsChecked="{Binding RememberKeyFilePaths}"
                          Content="Remember the keyfile path per vault" />
                <TextBlock Style="{StaticResource Text.Caption}" Margin="28,0,0,8" TextWrapping="Wrap"
                           Text="A remembered keyfile path is not a second factor. It only makes the password longer." />
                <Button Style="{StaticResource Button.Default}" Height="32" HorizontalAlignment="Left"
                        Margin="0,4,0,16"
                        Content="Clear recent vaults" Command="{Binding ClearRecentVaultsCommand}" />

                <controls:SectionHeader Text="Writing" />
                <CheckBox Margin="0,0,0,8" IsChecked="{Binding SizeObfuscation}"
                          Content="Pad the file so its size does not reveal how much is inside" />
                <CheckBox Margin="0,0,0,16" IsChecked="{Binding ReencryptOnSave}"
                          Content="Re-encrypt everything on every save (slower; hides what changed)" />

                <controls:SectionHeader Text="Staging" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Text.Body}" VerticalAlignment="Center"
                               Text="Where imports are staged" />
                    <ComboBox Grid.Column="1" HorizontalAlignment="Left" Width="260"
                              ItemsSource="{Binding StagingLocations}"
                              ItemTemplate="{StaticResource Settings.ChoiceItem}" SelectedValuePath="Value" SelectedValue="{Binding StagingLocation}" />
                </Grid>
                <Grid Margin="0,0,0,16" Visibility="{Binding IsCustomStaging, Converter={StaticResource Converter.BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding StagingCustomPath}" Tag="Custom staging directory" />
                    <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource Button.Default}" Height="32"
                            Content="Choose..." Command="{Binding ChooseStagingPathCommand}" />
                </Grid>

                <controls:SectionHeader Text="Windows integration" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Right margin keeps the wrapping caption clear of the button in the next column. -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="Register the .bastion file type" />
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   Text="Written under your own user only. Bastion Vault never registers itself behind your back." />
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource Button.Default}" Height="32"
                            MinWidth="120"
                            Command="{Binding ToggleFileAssociationCommand}">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                    <Setter Property="Text" Value="Register" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFileTypeRegistered}" Value="True">
                                            <Setter Property="Text" Value="Unregister" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </Grid>

                <CheckBox Margin="0,16,0,0" IsChecked="{Binding ShowFirstRun}"
                          Content="Show the first-run screen again next time" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
