<UserControl x:Class="BastionVault.App.Dialogs.ChangeCredentialsDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BastionVault.App.Controls"
             xmlns:core="clr-namespace:BastionVault.Core;assembly=BastionVault.Core"
             xmlns:dialogs="clr-namespace:BastionVault.App.ViewModels.Dialogs"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=dialogs:ChangeCredentialsDialogViewModel}">

    <DockPanel Margin="24" Width="560">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Title}" Text="{Binding Title}" />

        <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
            <Border Padding="10,8" Margin="0,0,0,12"
                    Background="{DynamicResource Brush.Bg2}"
                    BorderBrush="{DynamicResource Brush.DangerText}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Small}"
                    Visibility="{Binding HasError, Converter={StaticResource Converter.BoolToVisibility}}">
                <TextBlock Style="{StaticResource Text.Body}"
                           Foreground="{DynamicResource Brush.DangerText}"
                           TextWrapping="Wrap" Text="{Binding Error}" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Button.Default}" Height="36" Margin="0,0,8,0"
                        Content="Cancel" Command="{Binding CancelCommand}" />
                <Button Style="{StaticResource Button.Primary}" MinWidth="160"
                        Content="Change password"
                        IsEnabled="{Binding CanApply}"
                        Click="OnApply" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">

                <controls:SectionHeader Text="Confirm it is you" />
                <PasswordBox x:Name="CurrentField" Margin="0,0,0,4"
                             PasswordChanged="OnPasswordChanged"
                             AutomationProperties.Name="Current password" />
                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,0,16" TextWrapping="Wrap"
                           Text="The current password is required so a change cannot be made at an unattended, unlocked machine." />

                <controls:SectionHeader Text="New password" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <PasswordBox x:Name="NewField"
                                     PasswordChanged="OnPasswordChanged"
                                     AutomationProperties.Name="New password" />
                        <Border x:Name="RevealHost" Visibility="Collapsed" />
                    </Grid>
                    <Button Grid.Column="1" Margin="8,0,0,0"
                            Style="{StaticResource Button.Icon}"
                            ToolTip="Hold to reveal"
                            PreviewMouseLeftButtonDown="OnRevealDown"
                            PreviewMouseLeftButtonUp="OnRevealUp"
                            LostMouseCapture="OnRevealUp">
                        <TextBlock Style="{StaticResource Style.Glyph16}" Text="{DynamicResource Glyph.Reveal}" />
                    </Button>
                </Grid>

                <PasswordBox x:Name="ConfirmField" Margin="0,8,0,0"
                             PasswordChanged="OnPasswordChanged"
                             AutomationProperties.Name="Confirm new password" />

                <Border x:Name="CapsBanner"
                        Margin="0,8,0,0" Padding="10,6" Visibility="Collapsed"
                        Background="{DynamicResource Brush.Bg2}"
                        BorderBrush="{DynamicResource Brush.Warning}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Small}">
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Foreground="{DynamicResource Brush.TextPrimary}"
                               Text="Caps Lock is on." />
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding StrengthLevelText}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Text.Body}" Margin="0,4,0,16" TextWrapping="Wrap"
                           Text="{Binding StrengthSentence}" />

                <controls:SectionHeader Text="Key derivation" />
                <ItemsControl ItemsSource="{Binding Presets}" Margin="0,0,0,16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="Preset" Margin="0,4"
                                         Tag="{Binding}"
                                         Loaded="OnPresetLoaded"
                                         Checked="OnPresetChecked">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding Name}" />
                                        <TextBlock Style="{StaticResource Text.Mono}" Margin="10,0,0,0"
                                                   Text="{Binding ParameterText}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding Estimate}" />
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <controls:SectionHeader Text="Keyfile" />
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                               Style="{StaticResource Text.Body}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding KeyFilePath, TargetNullValue='No keyfile'}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Default}" Height="32" Content="Choose..."
                                Command="{Binding ChooseKeyFileCommand}" />
                        <Button Style="{StaticResource Button.Default}" Height="32" Margin="8,0,0,0" Content="Remove"
                                Command="{Binding RemoveKeyFileCommand}" />
                    </StackPanel>
                </Grid>

                <controls:SectionHeader Text="How it is applied" />
                <RadioButton GroupName="Mode" Margin="0,4" Tag="Rekey"
                             Loaded="OnModeLoaded" Checked="OnModeChecked">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Re-key everything (default)" />
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   Text="A fresh vault key and fresh blob ids; the whole file is rewritten at the next save." />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="Mode" Margin="0,4" Tag="RewrapOnly"
                             Loaded="OnModeLoaded" Checked="OnModeChecked">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Fast: rewrap only" />
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   Text="Only the header changes. Instant, but the data stays under the old vault key." />
                    </StackPanel>
                </RadioButton>

                <Border Margin="0,12,0,0" Padding="10,8"
                        Background="{DynamicResource Brush.Bg2}"
                        BorderBrush="{DynamicResource Brush.StrokeDivider}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Small}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="{Binding ModeCaveat}" />
                        <TextBlock Style="{StaticResource Text.Mono}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="{Binding CostLine}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
