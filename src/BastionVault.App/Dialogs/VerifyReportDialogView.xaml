<UserControl x:Class="BastionVault.App.Dialogs.VerifyReportDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BastionVault.App.Controls"
             xmlns:dialogs="clr-namespace:BastionVault.App.ViewModels.Dialogs"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=dialogs:VerifyReportDialogViewModel}">

    <DockPanel Margin="24" MinWidth="520" MaxWidth="640">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Title}" Text="{Binding Title}" />

        <StackPanel DockPanel.Dock="Top" Margin="0,10,0,0">
            <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding Summary}" />
            <TextBlock Style="{StaticResource Text.Body}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="{Binding LayoutLine}" />
        </StackPanel>

        <Button DockPanel.Dock="Bottom"
                HorizontalAlignment="Right"
                Margin="0,20,0,0"
                MinWidth="110"
                Style="{StaticResource Button.Primary}"
                Content="Close"
                Command="{Binding CancelCommand}" />

        <StackPanel Margin="0,16,0,0">
            <StackPanel Visibility="{Binding IsClean, Converter={StaticResource Converter.BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Style.Glyph20}"
                               Text="{DynamicResource Glyph.Ok}"
                               Foreground="{DynamicResource Brush.Success}" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                               Style="{StaticResource Text.Body}"
                               Text="Every blob authenticated." />
                </StackPanel>
            </StackPanel>

            <StackPanel Visibility="{Binding IsClean, Converter={StaticResource Converter.InverseBoolToVisibility}}">
                <controls:SectionHeader Text="Failures" />
                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Style="{StaticResource Style.Glyph16}"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Top"
                                               Text="{DynamicResource Glyph.Error}"
                                               Foreground="{DynamicResource Brush.DangerText}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource Text.Mono}" TextWrapping="Wrap" Text="{Binding Path}" />
                                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Text="{Binding Detail}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</UserControl>
