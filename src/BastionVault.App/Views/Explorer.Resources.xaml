<!--
    Everything the explorer views share: the converters they bind through, the view-model to view
    mapping the shell uses to host the explorer, and the handful of styles that only exist inside
    the explorer. This dictionary is merged next to Lamplight.xaml, so every reference to a theme
    key here must be a DynamicResource - a StaticResource cannot see a sibling dictionary.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:BastionVault.App.Converters"
                    xmlns:views="clr-namespace:BastionVault.App.Views"
                    xmlns:vm="clr-namespace:BastionVault.App.ViewModels">

    <!-- Converters -->
    <conv:ByteSizeConverter x:Key="Converter.ByteSize" />
    <conv:RelativeDateConverter x:Key="Converter.RelativeDate" />
    <conv:GlyphKeyConverter x:Key="Converter.GlyphKey" />
    <conv:EntryKindToGlyphConverter x:Key="Converter.KindGlyph" />
    <conv:FileTypeToGlyphConverter x:Key="Converter.TypeGlyph" />
    <conv:FileTypeToNameConverter x:Key="Converter.TypeName" />
    <conv:StateToPipConverter x:Key="Converter.StatePip" />
    <conv:EnumMatchConverter x:Key="Converter.EnumMatch" />
    <conv:EnumMatchToVisibilityConverter x:Key="Converter.EnumMatchVisibility" />
    <conv:AllTrueToVisibilityConverter x:Key="Converter.AllTrue" />

    <!-- The shell hosts the explorer through this template. -->
    <DataTemplate DataType="{x:Type vm:ExplorerViewModel}">
        <views:ExplorerView />
    </DataTemplate>

    <!-- Breadcrumb -->
    <Style x:Key="Explorer.Crumb" TargetType="Button">
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Text}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.Body}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.RingTight}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Radius.Small}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}">
                            <ContentPresenter.Resources>
                                <!--
                                    A string content renders through the app-wide implicit
                                    TextBlock style, whose 20 px Body line box does not fit the
                                    chip - which is what sliced the descender of "changed" - and
                                    whose Foreground outranks the amber the chip hands down. With
                                    no style of their own the metrics come from the caption font
                                    the template binds, and the colour is inherited.
                                -->
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
                                    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Bg2}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Bg3}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Explorer.CrumbCurrent" TargetType="Button" BasedOn="{StaticResource Explorer.Crumb}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- The chevron between crumbs, which also opens the sibling dropdown. -->
    <Style x:Key="Explorer.CrumbChevron" TargetType="ToggleButton">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Radius.Small}">
                        <TextBlock x:Name="Glyph"
                                   Text="{DynamicResource Glyph.ChevronRight}"
                                   FontFamily="{DynamicResource Font.Icons}" FontSize="9"
                                   Foreground="{DynamicResource Brush.TextDisabled}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Bg2}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Glyph" Property="Text" Value="{DynamicResource Glyph.ChevronDown}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Status bar chip -->
    <!--
        20 px, not 18: at 18 the 1 px border plus the caption's 16 px line box left no room for a
        descender, and the "g" of "changed" was sliced by the chip's own bottom edge in every
        screenshot set. 20 still clears the 26 px status bar with 3 px either side.
    -->
    <Style x:Key="Explorer.StatusChip" TargetType="ButtonBase">
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.StrokeDivider}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Small}" />
        <Setter Property="FontSize" Value="{DynamicResource Size.Caption}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Focus.RingTight}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Small}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Bg2}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The pending chip carries the lamp, because it is the one thing a save acts on. -->
    <Style x:Key="Explorer.PendingChip" TargetType="ButtonBase" BasedOn="{StaticResource Explorer.StatusChip}">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentDim}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>

</ResourceDictionary>
