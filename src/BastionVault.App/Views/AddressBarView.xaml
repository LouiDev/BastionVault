<UserControl x:Class="BastionVault.App.Views.AddressBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:BastionVault.App.Converters"
             xmlns:vm="clr-namespace:BastionVault.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ExplorerViewModel}"
             Height="{DynamicResource Height.Breadcrumb}"
             Background="{DynamicResource Brush.Bg1}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid Margin="8,0,12,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Back, forward, up. Alt+Left, Alt+Right, Alt+Up and Backspace do the same. -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource Button.Icon}" Width="26" Height="26"
                    ToolTip="{conv:ShortcutText Id=Back, Name=Back}"
                    AutomationProperties.Name="Back"
                    Command="{Binding BackCommand}">
                <TextBlock Style="{StaticResource Style.Glyph16}" FontSize="13" Text="{DynamicResource Glyph.Back}" />
            </Button>
            <Button Style="{StaticResource Button.Icon}" Width="26" Height="26"
                    ToolTip="{conv:ShortcutText Id=Forward, Name=Forward}"
                    AutomationProperties.Name="Forward"
                    Command="{Binding ForwardCommand}">
                <TextBlock Style="{StaticResource Style.Glyph16}" FontSize="13" Text="{DynamicResource Glyph.Forward}" />
            </Button>
            <Button Style="{StaticResource Button.Icon}" Width="26" Height="26"
                    ToolTip="{conv:ShortcutText Id=Up, Name=Up}"
                    AutomationProperties.Name="Up"
                    Command="{Binding UpCommand}">
                <TextBlock Style="{StaticResource Style.Glyph16}" FontSize="13" Text="{DynamicResource Glyph.Up}" />
            </Button>
            <Separator Style="{StaticResource Style.SeamVertical}" Height="18" Margin="6,0,4,0" />
        </StackPanel>

        <!-- Crumbs, or the editable path box. -->
        <Grid Grid.Column="1" VerticalAlignment="Center">
            <Border x:Name="CrumbRow"
                    Background="Transparent"
                    MouseLeftButtonDown="OnCrumbRowClicked"
                    ToolTip="{Binding AddressBar.Path}"
                    Visibility="{Binding AddressBar.IsEditing, Converter={StaticResource Converter.InverseBoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding AddressBar.Crumbs}" HorizontalAlignment="Left">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding Name}"
                                        Command="{Binding NavigateCommand}"
                                        AutomationProperties.Name="{Binding Name}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Explorer.Crumb}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Grid>
                                    <ToggleButton Style="{StaticResource Explorer.CrumbChevron}"
                                                  AutomationProperties.Name="Sibling folders"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay}"
                                                  Command="{Binding OpenDropDownCommand}" />
                                    <Popup IsOpen="{Binding IsDropDownOpen, Mode=TwoWay}"
                                           StaysOpen="False"
                                           Placement="Bottom"
                                           AllowsTransparency="True"
                                           PopupAnimation="Fade">
                                        <Border Background="{DynamicResource Brush.Bg2}"
                                                BorderBrush="{DynamicResource Brush.StrokeDivider}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource Radius.Medium}"
                                                Padding="0,4"
                                                MinWidth="180"
                                                MaxHeight="360">
                                            <ItemsControl ItemsSource="{Binding Siblings}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource Explorer.Crumb}"
                                                                HorizontalContentAlignment="Left"
                                                                HorizontalAlignment="Stretch"
                                                                Padding="10,0"
                                                                Command="{Binding NavigateCommand}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Style="{StaticResource Style.TypeGlyph}"
                                                                           FontSize="13"
                                                                           Text="{DynamicResource Glyph.Folder}" />
                                                                <!--
                                                                    The label sets its own line
                                                                    box: the app-wide 20 px Body
                                                                    box carries the baseline near
                                                                    the bottom, so a centred name
                                                                    sat three pixels below the
                                                                    folder icon beside it.
                                                                -->
                                                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                                                           LineHeight="{DynamicResource Size.Body}"
                                                                           LineStackingStrategy="BlockLineHeight"
                                                                           Text="{Binding Name}" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBox x:Name="PathBox"
                     Height="26"
                     IsUndoEnabled="False"
                     AutomationProperties.Name="Vault path"
                     Text="{Binding AddressBar.EditText, UpdateSourceTrigger=PropertyChanged}"
                     PreviewKeyDown="OnPathBoxKeyDown"
                     LostKeyboardFocus="OnPathBoxLostFocus"
                     Visibility="{Binding AddressBar.IsEditing, Converter={StaticResource Converter.BoolToVisibility}}">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource TextBox.Default}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AddressBar.HasError}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerText}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <!-- Autocomplete over the folders that actually exist. -->
            <Popup IsOpen="{Binding AddressBar.IsSuggestionListOpen, Mode=TwoWay}"
                   PlacementTarget="{Binding ElementName=PathBox}"
                   Placement="Bottom"
                   StaysOpen="True"
                   Focusable="False"
                   AllowsTransparency="True"
                   Width="{Binding ActualWidth, ElementName=PathBox}">
                <Border Background="{DynamicResource Brush.Bg2}"
                        BorderBrush="{DynamicResource Brush.StrokeDivider}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Medium}"
                        Padding="0,4"
                        MaxHeight="280">
                    <ListBox x:Name="SuggestionList"
                             Style="{StaticResource ListBox.Default}"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding AddressBar.Suggestions}"
                             MouseLeftButtonUp="OnSuggestionClicked">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource Text.Body}" Text="{Binding}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Popup>
        </Grid>
    </Grid>
</UserControl>
