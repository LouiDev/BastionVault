<UserControl x:Class="BastionVault.App.Views.EmptyStateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="Root"
             Background="Transparent"
             IsHitTestVisible="False"
             Focusable="False"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <!--
        Blueprint empty state (UI-CONTRACT.md section 2, signature detail 7): 1 px amber line art
        under a headline and one sentence that says what to do next. The art is geometry, so it is
        crisp at every DPI, and it never intercepts a click.
    -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Margin="24">
        <Viewbox Width="120" Height="120" HorizontalAlignment="Center">
            <Path Style="{StaticResource Style.Blueprint}"
                  Data="{Binding Blueprint, ElementName=Root}" />
        </Viewbox>

        <TextBlock Style="{StaticResource Text.Title}"
                   Margin="0,20,0,0"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Text="{Binding Headline, ElementName=Root}" />

        <TextBlock Style="{StaticResource Text.BodySecondary}"
                   Margin="0,8,0,0"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Text="{Binding Body, ElementName=Root}" />
    </StackPanel>
</UserControl>
