<UserControl x:Class="Bastion.App.Dialogs.NewVaultDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Bastion.App.Controls"
             xmlns:dialogs="clr-namespace:Bastion.App.ViewModels.Dialogs"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=dialogs:NewVaultDialogViewModel}">

    <DockPanel Margin="24" Width="560">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Title}" Text="{Binding Title}" />

        <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
            <!--
                The acknowledgement is a requirement of the primary action, so it is pinned here
                rather than left at the bottom of the scrolling content, where at the default
                window size it was below the fold with nothing to say it was there.
            -->
            <Separator Style="{StaticResource Style.Seam}" Margin="0,0,0,12" />

            <CheckBox Margin="0,0,0,12" IsChecked="{Binding Acknowledged}">
                <TextBlock TextWrapping="Wrap"
                           Text="I understand that if I lose this password, nobody can recover this vault." />
            </CheckBox>

            <Border Padding="10,8" Margin="0,0,0,12"
                    Background="{DynamicResource Brush.Bg2}"
                    BorderBrush="{DynamicResource Brush.DangerText}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Small}"
                    Visibility="{Binding HasError, Converter={StaticResource Converter.BoolToVisibility}}">
                <TextBlock Style="{StaticResource Text.Body}"
                           Foreground="{DynamicResource Brush.DangerText}"
                           TextWrapping="Wrap" Text="{Binding Error}" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Says why the primary is disabled, so a gated dialog does not read as broken. -->
                <TextBlock Style="{StaticResource Text.Caption}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           TextWrapping="Wrap"
                           MaxWidth="260"
                           Text="{Binding BlockingReason}"
                           Visibility="{Binding HasBlockingReason, Converter={StaticResource Converter.BoolToVisibility}}" />
                <Button Style="{StaticResource Button.Default}" Height="36" Margin="0,0,8,0"
                        Content="Cancel" Command="{Binding CancelCommand}" />
                <Button x:Name="CreateButton"
                        Style="{StaticResource Button.Primary}"
                        MinWidth="140"
                        Content="Create vault"
                        IsEnabled="{Binding CanCreate}"
                        Click="OnCreate" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">

                <controls:SectionHeader Text="Where the vault goes" />
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" IsReadOnly="True" Style="{StaticResource TextBox.Mono}"
                             Tag="No file chosen yet" Text="{Binding Path, Mode=OneWay}" />
                    <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource Button.Default}" Height="32"
                            Content="Choose..." Command="{Binding ChoosePathCommand}" />
                </Grid>

                <controls:SectionHeader Text="Password" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <PasswordBox x:Name="PasswordField"
                                     PasswordChanged="OnPasswordChanged"
                                     KeyDown="OnPasswordKeyDown"
                                     AutomationProperties.Name="New vault password" />
                        <Border x:Name="RevealHost" Visibility="Collapsed" />
                    </Grid>
                    <Button Grid.Column="1" Margin="8,0,0,0"
                            Style="{StaticResource Button.Icon}"
                            ToolTip="Hold to reveal"
                            PreviewMouseLeftButtonDown="OnRevealDown"
                            PreviewMouseLeftButtonUp="OnRevealUp"
                            LostMouseCapture="OnRevealUp">
                        <TextBlock Style="{StaticResource Style.Glyph16}" Text="{DynamicResource Glyph.Reveal}" />
                    </Button>
                </Grid>

                <PasswordBox x:Name="ConfirmField"
                             Margin="0,8,0,0"
                             PasswordChanged="OnPasswordChanged"
                             KeyDown="OnPasswordKeyDown"
                             AutomationProperties.Name="Confirm password" />

                <TextBlock x:Name="MismatchLine"
                           Margin="0,6,0,0"
                           Style="{StaticResource Text.Caption}"
                           Foreground="{DynamicResource Brush.DangerText}"
                           Visibility="Collapsed"
                           Text="The two passwords are different." />

                <Border x:Name="CapsBanner"
                        Margin="0,8,0,0" Padding="10,6"
                        Visibility="Collapsed"
                        Background="{DynamicResource Brush.Bg2}"
                        BorderBrush="{DynamicResource Brush.Warning}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Small}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Style.Glyph}" FontSize="12"
                                   Text="{DynamicResource Glyph.Warning}"
                                   Foreground="{DynamicResource Brush.Warning}" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                   Style="{StaticResource Text.Caption}"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   Text="Caps Lock is on." />
                    </StackPanel>
                </Border>

                <!-- Strength meter: greyscale track, one amber bar, and a sentence. -->
                <Grid x:Name="Meter" Height="4" Margin="0,12,0,0" Background="{DynamicResource Brush.Bg3}">
                    <Rectangle x:Name="MeterFill" HorizontalAlignment="Left"
                               Fill="{DynamicResource Brush.AccentDim}">
                        <Rectangle.Width>
                            <MultiBinding Converter="{StaticResource Converter.FractionOfWidth}">
                                <Binding Path="ActualWidth" ElementName="Meter" />
                                <Binding Path="StrengthFraction" />
                            </MultiBinding>
                        </Rectangle.Width>
                    </Rectangle>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding StrengthLevelText}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="10,0,0,0" VerticalAlignment="Center"
                               Visibility="{Binding IsTooShort, Converter={StaticResource Converter.BoolToVisibility}}"
                               Foreground="{DynamicResource Brush.DangerText}"
                               Text="At least eight characters." />
                </StackPanel>

                <TextBlock Style="{StaticResource Text.Body}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="{Binding StrengthSentence}" />
                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                           Visibility="{Binding Weakness, Converter={StaticResource Converter.NotEmptyToVisibility}}"
                           Text="{Binding Weakness}" />
                <Border Height="16" />

                <controls:SectionHeader Text="Key derivation" />
                <ItemsControl ItemsSource="{Binding Presets}" Margin="0,0,0,16">
                    <!-- Otherwise the container is announced as the view-model's type name. -->
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="Preset" Margin="0,4"
                                         Tag="{Binding}"
                                         Loaded="OnPresetLoaded"
                                         Checked="OnPresetChecked">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding Name}" />
                                        <TextBlock Style="{StaticResource Text.Mono}" Margin="10,0,0,0"
                                                   Text="{Binding ParameterText}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Description}" />
                                    <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding Estimate}" />
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <controls:SectionHeader Text="Keyfile (optional)" />
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.Body}" TextTrimming="CharacterEllipsis"
                                   Text="{Binding KeyFilePath, TargetNullValue='No keyfile'}" />
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   Text="A keyfile is a second thing you must have. Kept next to the vault it is only a longer password." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource Button.Default}" Height="32" Content="Choose..."
                                Command="{Binding ChooseKeyFileCommand}" />
                        <Button Style="{StaticResource Button.Default}" Height="32" Margin="8,0,0,0" Content="Generate..."
                                Command="{Binding GenerateKeyFileCommand}" />
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
