<UserControl x:Class="Bastion.App.Dialogs.AboutDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Bastion.App.Controls"
             xmlns:dialogs="clr-namespace:Bastion.App.ViewModels.Dialogs"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=dialogs:AboutDialogViewModel}">

    <StackPanel Margin="24" MinWidth="440" MaxWidth="560">
        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Style.Glyph32}"
                       Text="{DynamicResource Glyph.NewVault}"
                       Foreground="{DynamicResource Brush.Accent}" />
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.Title}" Text="Bastion" />
                <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding Version}" />
            </StackPanel>
        </StackPanel>

        <controls:SectionHeader Text="Format and cryptography" Margin="0,24,0,8" />
        <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding FormatVersion}" />
        <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding CryptoLine}" TextWrapping="Wrap" />

        <controls:SectionHeader Text="What this protects" Margin="0,20,0,8" />
        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="{Binding Promise}" />

        <Button HorizontalAlignment="Right"
                Margin="0,24,0,0"
                MinWidth="110"
                Style="{StaticResource Button.Primary}"
                Content="Close"
                Command="{Binding CancelCommand}" />
    </StackPanel>
</UserControl>
