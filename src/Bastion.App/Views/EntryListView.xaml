<UserControl x:Class="Bastion.App.Views.EntryListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:Bastion.App.Behaviors"
             xmlns:controls="clr-namespace:Bastion.App.Controls"
             xmlns:conv="clr-namespace:Bastion.App.Converters"
             xmlns:vm="clr-namespace:Bastion.App.ViewModels"
             xmlns:views="clr-namespace:Bastion.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ExplorerViewModel}"
             Background="{DynamicResource Brush.Bg1}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <!-- Name cell: type glyph, the name, and the inline rename editor that replaces it. -->
        <DataTemplate x:Key="Explorer.NameCell">
            <Border x:Name="Cell" Background="Transparent" Padding="6,0,4,0" CornerRadius="3">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Style.TypeGlyph}"
                                   FontSize="14"
                                   Text="{Binding Converter={StaticResource Converter.TypeGlyph}}" />
                        <TextBlock x:Name="PART_Name"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   behaviors:TrimmedToolTipBehavior.ShowWhenTrimmed="True"
                                   Text="{Binding Name}" />
                    </StackPanel>
                    <TextBox x:Name="PART_Rename"
                             Height="22"
                             Margin="22,0,0,0"
                             Padding="4,0"
                             IsUndoEnabled="False"
                             Visibility="Collapsed"
                             AutomationProperties.Name="New name" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Value="True"
                             Binding="{Binding (behaviors:ListDragBehavior.IsDropTarget),
                                               RelativeSource={RelativeSource AncestorType=ListViewItem}}">
                    <Setter TargetName="Cell" Property="Background" Value="{DynamicResource Brush.Bg3}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="Explorer.SizeCell">
            <TextBlock HorizontalAlignment="Right"
                       Margin="0,0,10,0"
                       Style="{StaticResource Text.Caption}"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Text="{Binding Converter={StaticResource Converter.ByteSize}}" />
        </DataTemplate>

        <DataTemplate x:Key="Explorer.TypeCell">
            <TextBlock Margin="6,0"
                       Style="{StaticResource Text.Caption}"
                       TextTrimming="CharacterEllipsis"
                       behaviors:TrimmedToolTipBehavior.ShowWhenTrimmed="True"
                       Text="{Binding TypeName}" />
        </DataTemplate>

        <DataTemplate x:Key="Explorer.ModifiedCell">
            <TextBlock Margin="6,0"
                       Style="{StaticResource Text.Caption}"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding ModifiedUtc, Converter={StaticResource Converter.RelativeDate}}" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ListView x:Name="List"
                  ItemsSource="{Binding Items}"
                  SelectionMode="Extended"
                  IsTextSearchEnabled="True"
                  TextSearch.TextPath="RealName"
                  AutomationProperties.Name="Entries"
                  SelectionChanged="OnSelectionChanged"
                  MouseDoubleClick="OnDoubleClick"
                  PreviewMouseRightButtonDown="OnRightButtonDown"
                  behaviors:ListDragBehavior.Explorer="{Binding}"
                  behaviors:ColumnSortBehavior.Explorer="{Binding}"
                  behaviors:InlineRenameBehavior.Explorer="{Binding}">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource ListViewItem.Default}">
                    <Setter Property="controls:ItemAdornments.Pip" Value="{Binding State, Converter={StaticResource Converter.StatePip}}" />
                    <Setter Property="controls:ItemAdornments.IsCut" Value="{Binding IsCut}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <!-- Item context menu. Open is the default action, so it is bold. -->
                            <ContextMenu>
                                <MenuItem Header="Open" FontWeight="SemiBold"
                                          InputGestureText="{conv:ShortcutText Id=Open}"
                                          Command="{Binding PlacementTarget.Tag.OpenEntryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Style.Glyph16}" FontSize="14" Text="{DynamicResource Glyph.Open}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Preview"
                                          InputGestureText="{conv:ShortcutText Id=Preview}"
                                          Command="{Binding PlacementTarget.Tag.PreviewFocusedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Style.Glyph16}" FontSize="14" Text="{DynamicResource Glyph.Preview}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Cut"
                                          InputGestureText="{conv:ShortcutText Id=Cut}"
                                          Command="{Binding PlacementTarget.Tag.CutCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Style.Glyph16}" FontSize="14" Text="{DynamicResource Glyph.Cut}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Copy"
                                          InputGestureText="{conv:ShortcutText Id=Copy}"
                                          Command="{Binding PlacementTarget.Tag.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Style.Glyph16}" FontSize="14" Text="{DynamicResource Glyph.Copy}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Paste"
                                          InputGestureText="{conv:ShortcutText Id=Paste}"
                                          Command="{Binding PlacementTarget.Tag.PasteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Style.Glyph16}" FontSize="14" Text="{DynamicResource Glyph.Paste}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Copy path"
                                          InputGestureText="{conv:ShortcutText Id=CopyPath}"
                                          Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="Rename"
                                          InputGestureText="{conv:ShortcutText Id=Rename}"
                                          Command="{Binding PlacementTarget.Tag.RenameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Style.Glyph16}" FontSize="14" Text="{DynamicResource Glyph.Rename}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Delete"
                                          InputGestureText="{conv:ShortcutText Id=Delete}"
                                          Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Style.Glyph16}" FontSize="14"
                                                   Foreground="{DynamicResource Brush.DangerText}"
                                                   Text="{DynamicResource Glyph.Delete}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Export..."
                                          InputGestureText="{conv:ShortcutText Id=Export}"
                                          Command="{Binding PlacementTarget.Tag.ExportCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Style.Glyph16}" FontSize="14" Text="{DynamicResource Glyph.Export}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Properties"
                                          InputGestureText="{conv:ShortcutText Id=Properties}"
                                          Command="{Binding PlacementTarget.Tag.PropertiesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Style.Glyph16}" FontSize="14" Text="{DynamicResource Glyph.Properties}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>

            <!-- Blank-area context menu: what can be done to the folder itself. -->
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="New folder" FontWeight="SemiBold"
                              InputGestureText="{conv:ShortcutText Id=NewFolder}"
                              Command="{Binding NewFolderCommand}">
                        <MenuItem.Icon>
                            <TextBlock Style="{StaticResource Style.Glyph16}" FontSize="14" Text="{DynamicResource Glyph.NewFolder}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Import files..."
                              InputGestureText="{conv:ShortcutText Id=ImportFiles}"
                              Command="{Binding ImportFilesCommand}">
                        <MenuItem.Icon>
                            <TextBlock Style="{StaticResource Style.Glyph16}" FontSize="14" Text="{DynamicResource Glyph.ImportFiles}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Import folder..."
                              InputGestureText="{conv:ShortcutText Id=ImportFolder}"
                              Command="{Binding ImportFolderCommand}">
                        <MenuItem.Icon>
                            <TextBlock Style="{StaticResource Style.Glyph16}" FontSize="14" Text="{DynamicResource Glyph.ImportFolder}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Paste"
                              InputGestureText="{conv:ShortcutText Id=Paste}"
                              Command="{Binding PasteCommand}">
                        <MenuItem.Icon>
                            <TextBlock Style="{StaticResource Style.Glyph16}" FontSize="14" Text="{DynamicResource Glyph.Paste}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Select all"
                              InputGestureText="{conv:ShortcutText Id=SelectAll}"
                              Command="{Binding SelectAllCommand}">
                        <MenuItem.Icon>
                            <TextBlock Style="{StaticResource Style.Glyph16}" FontSize="14" Text="{DynamicResource Glyph.SelectAll}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Export everything..."
                              InputGestureText="{conv:ShortcutText Id=Export}"
                              Command="{Binding ExportCommand}">
                        <MenuItem.Icon>
                            <TextBlock Style="{StaticResource Style.Glyph16}" FontSize="14" Text="{DynamicResource Glyph.Export}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Undo"
                              InputGestureText="{conv:ShortcutText Id=Undo}"
                              Command="{Binding UndoCommand}">
                        <MenuItem.Icon>
                            <TextBlock Style="{StaticResource Style.Glyph16}" FontSize="14" Text="{DynamicResource Glyph.Undo}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Redo"
                              InputGestureText="{conv:ShortcutText Id=Redo}"
                              Command="{Binding RedoCommand}">
                        <MenuItem.Icon>
                            <TextBlock Style="{StaticResource Style.Glyph16}" FontSize="14" Text="{DynamicResource Glyph.Redo}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Properties"
                              InputGestureText="{conv:ShortcutText Id=Properties}"
                              Command="{Binding PropertiesCommand}">
                        <MenuItem.Icon>
                            <TextBlock Style="{StaticResource Style.Glyph16}" FontSize="14" Text="{DynamicResource Glyph.Properties}" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </ListView.ContextMenu>

            <ListView.View>
                <GridView AllowsColumnReorder="False"
                          ColumnHeaderContainerStyle="{StaticResource GridViewColumnHeader.Default}">
                    <!-- The status rail; 24 wide because the row presenter eats about 12 for cell padding. -->
                    <GridViewColumn Width="24" CellTemplate="{StaticResource GridView.StatusRailCell}" />
                    <GridViewColumn Width="226" Header="Name"
                                    behaviors:ColumnSortBehavior.SortKey="name"
                                    CellTemplate="{StaticResource Explorer.NameCell}" />
                    <GridViewColumn Width="80" Header="Size"
                                    behaviors:ColumnSortBehavior.SortKey="size"
                                    CellTemplate="{StaticResource Explorer.SizeCell}" />
                    <GridViewColumn Width="124" Header="Type"
                                    behaviors:ColumnSortBehavior.SortKey="type"
                                    CellTemplate="{StaticResource Explorer.TypeCell}" />
                    <GridViewColumn Width="124" Header="Modified"
                                    behaviors:ColumnSortBehavior.SortKey="modified"
                                    CellTemplate="{StaticResource Explorer.ModifiedCell}" />
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Empty states. They sit over the list, which keeps its header row. -->
        <views:EmptyStateView
                              Margin="0,28,0,0"
                              Blueprint="{StaticResource Blueprint.Folder}"
                              Headline="Nothing here yet"
                              Body="Drop files from Explorer, or use Import files to bring something in. Ctrl+Shift+N makes a folder."
                              Visibility="{Binding IsFolderEmpty, Converter={StaticResource Converter.BoolToVisibility}}" />

        <views:EmptyStateView
                              Margin="0,28,0,0"
                              Blueprint="{StaticResource Blueprint.Magnifier}"
                              Headline="No matches"
                              Body="Nothing in this folder matches. Turn on All to search the whole vault."
                              Visibility="{Binding IsSearchEmpty, Converter={StaticResource Converter.BoolToVisibility}}" />
    </Grid>
</UserControl>
