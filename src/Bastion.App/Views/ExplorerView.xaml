<UserControl x:Class="Bastion.App.Views.ExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:Bastion.App.Behaviors"
             xmlns:views="clr-namespace:Bastion.App.Views"
             xmlns:vm="clr-namespace:Bastion.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ExplorerViewModel}"
             Background="{DynamicResource Brush.Bg0}"
             Focusable="False"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType">

    <!--
        The explorer: command bar, address bar, then tree / list / preview separated by seams that
        can be grabbed, and the status bar. Everything below is a projection of ExplorerViewModel;
        the code-behind only does what a view model may not - focus, key routing and the row-height
        resource that the density setting swaps.
    -->
    <Grid x:Name="Root" behaviors:FileDropBehavior.Explorer="{Binding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <views:CommandBarView x:Name="CommandBar" Grid.Row="0" DataContext="{Binding CommandBar}" />
        <Separator Grid.Row="1" Style="{StaticResource Style.Seam}" />
        <views:AddressBarView x:Name="AddressBar" Grid.Row="2" DataContext="{Binding}" />
        <Separator Grid.Row="3" Style="{StaticResource Style.Seam}" />

        <Grid Grid.Row="4" Background="{DynamicResource Brush.Bg0}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="248" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="280" />
                <ColumnDefinition x:Name="PreviewSplitterColumn" Width="Auto" />
                <ColumnDefinition x:Name="PreviewColumn" Width="320" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <views:FolderTreeView x:Name="Tree" Grid.Column="0" DataContext="{Binding}" />

            <GridSplitter Grid.Column="1"
                          Style="{StaticResource GridSplitter.Seam}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          AutomationProperties.Name="Resize the folder tree" />

            <views:EntryListView x:Name="List" Grid.Column="2" DataContext="{Binding}" />

            <GridSplitter x:Name="PreviewSplitter"
                          Grid.Column="3"
                          Style="{StaticResource GridSplitter.Seam}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          AutomationProperties.Name="Resize the preview" />

            <views:PreviewPaneView x:Name="Preview" Grid.Column="4" DataContext="{Binding Preview}" />
        </Grid>

        <views:StatusBarView x:Name="StatusBar" Grid.Row="5" DataContext="{Binding StatusBar}" />
    </Grid>
</UserControl>
