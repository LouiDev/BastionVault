<UserControl x:Class="Bastion.App.Views.PreviewPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:Bastion.App.Behaviors"
             xmlns:controls="clr-namespace:Bastion.App.Controls"
             xmlns:views="clr-namespace:Bastion.App.Views"
             xmlns:vm="clr-namespace:Bastion.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="Pane"
             d:DataContext="{d:DesignInstance Type=vm:PreviewViewModel}"
             Background="{DynamicResource Brush.Bg1}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="12,10,12,8">
            <controls:SectionHeader Text="Preview" />
            <!--
                Both lines are empty while nothing is selected. An empty TextBlock still occupies a
                full line box, so without these triggers the header reserved two blank rows above
                the seam and the pane opened with a gap under "PREVIEW".
            -->
            <TextBlock Margin="0,6,0,0"
                       TextTrimming="CharacterEllipsis"
                       behaviors:TrimmedToolTipBehavior.ShowWhenTrimmed="True"
                       Text="{Binding Title}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.BodyStrong}">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Margin="0,2,0,0"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding InstrumentLine}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <Separator Grid.Row="1" Style="{StaticResource Style.Seam}" />

        <Grid Grid.Row="2" Margin="0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBlurred}" Value="True">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <BlurEffect Radius="14" KernelType="Gaussian" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!--
                Decoded text. Horizontal scrolling is DISABLED on purpose: a ScrollViewer that can
                scroll sideways measures its content with infinite width, so TextWrapping="Wrap"
                never wraps and every long line ran off the pane behind a scrollbar.
            -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          Padding="12,8"
                          Visibility="{Binding Mode, Converter={StaticResource Converter.EnumMatchVisibility}, ConverterParameter=Text}">
                <TextBlock Style="{StaticResource Text.Body}"
                           TextWrapping="Wrap"
                           Text="{Binding Text}" />
            </ScrollViewer>

            <!-- Hex dump of the first bytes. -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Padding="12,8"
                          Visibility="{Binding Mode, Converter={StaticResource Converter.EnumMatchVisibility}, ConverterParameter=Hex}">
                <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding Text}" />
            </ScrollViewer>

            <!-- Image, decoded no wider than this pane. -->
            <Grid Visibility="{Binding Mode, Converter={StaticResource Converter.EnumMatchVisibility}, ConverterParameter=Image}">
                <views:ImagePreview x:Name="Image"
                                    Margin="12"
                                    Stretch="Uniform"
                                    StretchDirection="DownOnly"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    Bytes="{Binding ImageBytes}"
                                    DecodePixelWidth="{Binding DecodeWidth}" />
                <TextBlock Style="{StaticResource Text.BodySecondary}"
                           Margin="24"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Text="{Binding Failure, ElementName=Image}"
                           Visibility="{Binding Failure, ElementName=Image, Converter={StaticResource Converter.NotEmptyToVisibility}}" />
            </Grid>

            <!-- Folder summary. -->
            <views:EmptyStateView Blueprint="{StaticResource Blueprint.Folder}"
                                  Headline="{Binding Title}"
                                  Body="{Binding InstrumentLine}"
                                  Visibility="{Binding Mode, Converter={StaticResource Converter.EnumMatchVisibility}, ConverterParameter=Folder}" />

            <!-- Nothing selected. -->
            <views:EmptyStateView Blueprint="{StaticResource Blueprint.Magnifier}"
                                  Headline="Nothing selected"
                                  Body="Select a file to see what is in it. Space previews the focused row."
                                  Visibility="{Binding Mode, Converter={StaticResource Converter.EnumMatchVisibility}, ConverterParameter=Empty}" />

            <!-- Hidden by panic mode or by the preview toggle. -->
            <views:EmptyStateView Blueprint="{StaticResource Blueprint.Padlock}"
                                  Headline="Preview off"
                                  Body="Ctrl+Shift+H turns names and preview back on."
                                  Visibility="{Binding Mode, Converter={StaticResource Converter.EnumMatchVisibility}, ConverterParameter=Hidden}" />

            <!-- Reading, refused, or failed. -->
            <TextBlock Style="{StaticResource Text.BodySecondary}"
                       Margin="24"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Text="Reading..."
                       Visibility="{Binding Mode, Converter={StaticResource Converter.EnumMatchVisibility}, ConverterParameter=Loading}" />

            <TextBlock Style="{StaticResource Text.BodySecondary}"
                       Margin="24"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Text="{Binding Message}"
                       Visibility="{Binding Mode, Converter={StaticResource Converter.EnumMatchVisibility}, ConverterParameter=TooLarge}" />

            <TextBlock Style="{StaticResource Text.Danger}"
                       Margin="24"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Text="{Binding Message}"
                       Visibility="{Binding Mode, Converter={StaticResource Converter.EnumMatchVisibility}, ConverterParameter=Failed}" />
        </Grid>
    </Grid>
</UserControl>
