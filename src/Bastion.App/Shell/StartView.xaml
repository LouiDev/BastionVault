<UserControl x:Class="Bastion.App.Shell.StartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Bastion.App.Controls"
             xmlns:vm="clr-namespace:Bastion.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StartViewModel}"
             Background="{DynamicResource Brush.Bg0}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid>
        <!-- Blueprint vault door: 1 px amber line art at 20 %. -->
        <Viewbox Width="300" Height="300" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,56,56" IsHitTestVisible="False">
            <Path Style="{StaticResource Style.Blueprint}" Data="{StaticResource Blueprint.VaultDoor}" />
        </Viewbox>

        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="720">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Style="{StaticResource Text.Hero}"
                       HorizontalAlignment="Center"
                       Text="No vault is open" />

            <TextBlock Grid.Row="1"
                       Style="{StaticResource Text.BodySecondary}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="520"
                       Margin="0,8,0,0"
                       Text="{Binding Tagline}" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                <Button Style="{StaticResource Button.Primary}"
                        MinWidth="150"
                        Command="{Binding CreateVaultCommand}"
                        AutomationProperties.Name="Create a new vault">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Style.Glyph16}"
                                   Text="{DynamicResource Glyph.NewVault}"
                                   Foreground="{DynamicResource Brush.OnAccent}" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Create vault" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource Button.Default}"
                        MinWidth="150" Height="36" Margin="12,0,0,0"
                        Command="{Binding OpenVaultCommand}"
                        AutomationProperties.Name="Open an existing vault">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Style.Glyph16}"
                                   Text="{DynamicResource Glyph.Open}"
                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Open vault" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Recents -->
            <Border Grid.Row="3" Margin="0,32,0,0" MinWidth="520"
                    Background="{DynamicResource Brush.Bg1}"
                    BorderBrush="{DynamicResource Brush.StrokeDivider}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Medium}"
                    Padding="16"
                    Visibility="{Binding HasRecents, Converter={StaticResource Converter.BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:SectionHeader Grid.Column="0" Text="Recent vaults" Margin="0,0,12,8" />
                        <Button Grid.Column="1"
                                Style="{StaticResource Button.Link}"
                                VerticalAlignment="Top"
                                Margin="0,-2,0,0"
                                Content="Clear"
                                Command="{Binding ClearRecentsCommand}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Recents}" Margin="0,4,0,0">
                        <!--
                            Without this the item container falls back to the record's ToString and
                            a screen reader reads "RecentVault { Path = ..., LastOpenedUtc = ... }".
                        -->
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Style="{StaticResource Button.Ghost}"
                                            HorizontalContentAlignment="Left"
                                            Height="40"
                                            Padding="8,0"
                                            Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Path}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Style.Glyph16}"
                                                       Text="{DynamicResource Glyph.Open}" />
                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Text.Body}"
                                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                                           Text="{Binding DisplayName}" />
                                                <TextBlock Style="{StaticResource Text.Caption}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="380"
                                                           Text="{Binding DisplayDirectory}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="1"
                                            Style="{StaticResource Button.Link}"
                                            VerticalAlignment="Center"
                                            Content="Forget"
                                            Command="{Binding DataContext.ForgetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Path}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
